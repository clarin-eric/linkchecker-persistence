<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>
   <parent>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-parent</artifactId>
      <version>4.0.2</version>
      <relativePath /> <!-- lookup parent from repository -->
   </parent>
   <groupId>eu.clarin</groupId>
   <artifactId>linkchecker-persistence-api</artifactId>
   <version>${revision}</version>
   <packaging>pom</packaging>
   <name>Linkchecker Persistence API</name>
   <modules>
      <module>linkchecker-persistence-model</module>
      <module>linkchecker-persistence</module>
   </modules>
   <properties>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <maven.compiler.source>21</maven.compiler.source>
      <maven.compiler.target>21</maven.compiler.target>
      <vlo.version>4.12.1</vlo.version>
      <revision>2.3.0-SNAPSHOT</revision>
   </properties>
   <dependencies>
      <dependency>
         <groupId>org.projectlombok</groupId>
         <artifactId>lombok</artifactId>
         <scope>provided</scope>
      </dependency>
   </dependencies>
   <repositories>
      <repository>
         <id>CLARIN</id>
         <name>CLARIN Repository</name>
         <url>https://nexus.clarin.eu/content/repositories/Clarin/</url>
      </repository>
      <repository>
         <id>CLARIN-Snapshot</id>
         <name>CLARIN Snapshot Repository</name>
         <url>https://nexus.clarin.eu/content/repositories/clarin-snapshot/</url>
         <releases>
            <enabled>false</enabled>
         </releases>
      </repository>
      <repository>
         <id>sonatype-apache</id>
         <url>https://repository.apache.org/releases</url>
         <releases>
            <enabled>false</enabled>
         </releases>
         <snapshots>
            <enabled>false</enabled>
         </snapshots>
      </repository>
   </repositories>
   <distributionManagement>
      <repository>
         <id>CLARIN</id>
         <name>CLARIN Repository</name>
         <url>https://nexus.clarin.eu/content/repositories/Clarin/</url>
      </repository>
      <snapshotRepository>
         <id>CLARIN-Snapshot</id>
         <name>CLARIN Snapshot Repository</name>
         <url>https://nexus.clarin.eu/content/repositories/clarin-snapshot/</url>
      </snapshotRepository>
   </distributionManagement>
</project>